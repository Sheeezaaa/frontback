# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database (Configured with connection pooling)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_orders?schema=public&connection_limit=15&pool_timeout=10"

# JWT Authentication
JWT_SECRET="replace-with-a-secure-random-256-bit-key"
JWT_EXPIRES_IN="1d"

# Apache Kafka / Upstash Kafka Configuration
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="saas-order-service"
KAFKA_GROUP_ID="saas-order-consumer-group"
KAFKA_TOPIC_ORDERS="tenant.orders"
KAFKA_SSL="false"
KAFKA_SASL_MECHANISM="plain"
KAFKA_USERNAME=""
KAFKA_PASSWORD=""

# Serverless Invoice Service (Vercel)
SERVERLESS_INVOICE_URL="http://localhost:3000/api/invoice"
